          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "method": "方法",
              "route": "路由",
              "Value #A": "请求数",
              "Value #B": "5xx",
              "Value #C": "p95"
            }
          }
        }
      ],
      "description": "按 Fastify 路由模板聚合；未匹配到路由的请求记为 unmatched。"
