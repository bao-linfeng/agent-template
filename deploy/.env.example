# Production settings for deploy/docker-compose.yml. Copy to deploy/.env (git-ignored) and fill every empty value.
# Compose interpolates this file, and the server containers also receive it through `env_file`, so any
# variable from apps/server/.env.example (THROTTLE_*, LOG_LEVEL, UPLOAD_MAX_BYTES ...) can be added here.
# DATABASE_URL, REDIS_URL, STORAGE_ENDPOINT, PUBLIC_URL, APP_WEB_URL and CORS_ORIGINS are derived in the compose file.

# --- Images ---
# Registry/namespace of the server, admin and client images (pushed by .github/workflows/release.yml).
IMAGE_REGISTRY=ghcr.io/bao-linfeng/agent-template
# Release tag to run; scripts/deploy.sh <tag> overrides it, scripts/deploy.sh --build uses the git commit.
IMAGE_TAG=latest

# --- Domains (DNS A/AAAA records must point at this host; Caddy issues HTTPS certificates) ---
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
CLIENT_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
API_PREFIX=api

# --- Secrets (generate, then keep them safe: losing ENCRYPTION_KEY makes stored API keys unreadable) ---
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32
ENCRYPTION_KEY=

# --- PostgreSQL (passwords end up in connection URLs: use openssl rand -hex 32) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_PASSWORD=

# --- Object storage (bundled RustFS; the API creates the bucket on first start) ---
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=app
STORAGE_REGION=us-east-1

# --- Mail (a real SMTP service; there is no Mailpit in production) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Agent Template <no-reply@example.com>"

LOG_LEVEL=info

# --- Seed (docker compose run --rm seed; only needed for the first super admin) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NICKNAME=Administrator
# Default embedding model created by the seed; adjust later in the admin console.
SEED_EMBEDDING_NAME=bge-m3
SEED_EMBEDDING_BASE_URL=http://localhost:11434/v1
SEED_EMBEDDING_MODEL=bge-m3
SEED_EMBEDDING_DIMENSIONS=1024
# SEED_EMBEDDING_API_KEY=

# --- Container logs (rotated per container; applied when containers are recreated) ---
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=5

# --- Monitoring (optional; deploy/observability, README.md "监控与告警") ---
# Starts Prometheus, Alertmanager, alert-relay, Tempo and Grafana with the rest of the stack.
# COMPOSE_PROFILES=observability
# Sends the API's traces to Tempo (leave unset without the observability profile).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# Share of new traces kept (0-1).
# OTEL_TRACES_SAMPLER_ARG=1
# Grafana on 127.0.0.1:GRAFANA_PORT only (ssh -L 3000:127.0.0.1:3000 <host>); user admin. Required with the profile.
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000
# GRAFANA_ROOT_URL=http://localhost:3000
# PROMETHEUS_RETENTION=15d
# TEMPO_RETENTION=168h
# Alert email recipients (comma-separated); sent with the SMTP_* settings above and MAIL_FROM (or ALERT_EMAIL_FROM).
ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
# With SMTP_SECURE=false: fail instead of sending in clear text when the server offers no STARTTLS.
# ALERT_SMTP_REQUIRE_TLS=true
# Group bot webhooks; leave empty to skip. Signing secrets only when "加签" is enabled on the bot.
# WeCom: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
ALERT_WECOM_WEBHOOK_URL=
# Feishu: https://open.feishu.cn/open-apis/bot/v2/hook/...
ALERT_FEISHU_WEBHOOK_URL=
ALERT_FEISHU_SECRET=
# DingTalk: https://oapi.dingtalk.com/robot/send?access_token=...
ALERT_DINGTALK_WEBHOOK_URL=
ALERT_DINGTALK_SECRET=
# Time zone of the times in bot messages.
# ALERT_TIMEZONE=Asia/Shanghai

# --- Backups (scripts/backup.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Also copy the object storage bucket into each backup (true/false).
BACKUP_STORAGE=true
