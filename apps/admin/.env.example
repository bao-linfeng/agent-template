# API server (apps/server). Empty VITE_SERVER_API_URL = same origin: the dev server proxies
# VITE_SERVER_API_PREFIX to API_PROXY_TARGET (default http://localhost:3100), so sign-in works on
# localhost, 127.0.0.1 or a LAN IP alike. Set an absolute URL (e.g. https://api.example.com) to call
# the API directly; then the server's CORS_ORIGINS must list this app's origin.
VITE_SERVER_API_URL=
VITE_SERVER_API_PREFIX=/api
VITE_SERVER_API_TIMEOUT=5000
# API_PROXY_TARGET=http://localhost:3100
