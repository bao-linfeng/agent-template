# apps/server API root including the /api prefix. Unset (the default) = `/api` on this app's own
# origin: the dev server proxies it to API_PROXY_TARGET (default http://localhost:3100), so sign-in
# works on localhost, 127.0.0.1 or a LAN IP alike. With an absolute URL (e.g.
# https://api.example.com/api) the server must list this app's origin in CORS_ORIGINS.
# VITE_API_BASE_URL=http://localhost:3100/api
# API_PROXY_TARGET=http://localhost:3100
