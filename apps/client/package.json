{
  "name": "client",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Agent Template client app (Vue 3, shadcn-vue, Vite).",
  "author": "baolf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bao-linfeng/agent-template",
    "directory": "apps/client"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:prod": "vue-tsc -b && vite build --mode production",
    "check-types": "vue-tsc -b",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@tanstack/vue-query": "catalog:",
    "class-variance-authority": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "terser": "^5.36.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
