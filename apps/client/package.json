{
  "name": "vue-shadcn-starter",
  "type": "module",
  "version": "1.0.5",
  "private": true,
  "description": "A starter project for Vue 3 with Shadcn UIKit and Tailwind CSS",
  "author": "Alexy-OS",
  "license": "MIT",
  "repository": "https://github.com/alexy-os/vue-shadcn-starter",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:prod": "vue-tsc -b && vite build --mode production",
    "check-types": "vue-tsc -b",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "class-variance-authority": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "terser": "^5.36.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
