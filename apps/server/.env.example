# Copy to .env (or .env.local, which wins) and adjust. docker-compose.yml reads the same file.
# Every variable is validated in src/config/env.ts; defaults below match the local Docker stack.

NODE_ENV=development
PORT=3100
API_PREFIX=api
# Public base URL of this API (used for absolute avatar URLs).
PUBLIC_URL=http://localhost:3100
# Web app that renders /reset-password?token=... links sent by email.
APP_WEB_URL=http://localhost:5175
CORS_ORIGINS=http://localhost:5175,http://localhost:5174
# Set to true behind a reverse proxy so client IPs (rate limiting, sessions) come from X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info
# Swagger UI at /api/docs; defaults to true outside production.
# SWAGGER_ENABLED=true

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_POOL_MAX=10
# Statement limit, idle-in-transaction limit and wait for a connection, in ms (0 = none)
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Required in production (>= 32 chars): openssl rand -base64 48
# JWT_SECRET=
# Required in production, 32 bytes base64 (encrypts embedding API keys and admin TOTP secrets): openssl rand -base64 32
# ENCRYPTION_KEY=
# Key rotation: comma-separated old keys, decrypt only. Run `pnpm db:reencrypt`, then remove them.
# ENCRYPTION_KEYS_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Client sessions are extended by REFRESH_TOKEN_TTL_SECONDS on every refresh, up to this long after sign-in (admin sessions do not slide).
CLIENT_SESSION_MAX_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=1800
# Email verification codes (client registration): lifetime and resend cooldown.
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_SECONDS=60
# Name shown for admin accounts in authenticator apps (admin two-factor authentication).
MFA_TOTP_ISSUER=Agent Admin
PASSWORD_HASH_ROUNDS=12
# Defaults to true in production. Browsers accept Secure cookies on http://localhost too.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# --- Rate limiting (per client IP) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# --- Object storage (RustFS locally, any S3-compatible service in production) ---
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_BUCKET=app
STORAGE_FORCE_PATH_STYLE=true
STORAGE_AUTO_CREATE_BUCKET=true
AVATAR_MAX_BYTES=2097152
UPLOAD_MAX_BYTES=20971520
# Malware scan of uploads through clamd (docker compose --profile antivirus, or add antivirus to COMPOSE_PROFILES).
# Off while unset; once set, uploads are rejected with 503 whenever clamd cannot scan them.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000

# --- Mail (Mailpit catches everything locally: http://localhost:8025) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="Agent Template <no-reply@example.com>"

# --- Audit log (audit_logs; admin console: /api/v1/admin/audit-logs) ---
# Every write request (POST/PUT/PATCH/DELETE) is recorded; set AUDIT_LOG_READS=true to record GETs too.
AUDIT_LOG_ENABLED=true
AUDIT_LOG_READS=false
# Older rows are deleted daily; 0 keeps them forever.
AUDIT_LOG_RETENTION_DAYS=180

# --- Housekeeping (BullMQ job schedulers on queue "maintenance") ---
# The next two are defaults of runtime settings (admin console → /api/v1/admin/settings,
# maintenance.authRecordRetentionDays / maintenance.storageOrphanSweepEnabled); a value set there wins.
# Sessions that expired or were revoked, and reset tokens that expired or were used, are deleted this many
# days later (daily at 03:30); 0 keeps them forever.
AUTH_RECORD_RETENTION_DAYS=30
# Daily at 04:00: delete avatar, RAG source and export objects (older than 24 h) that no row references anymore.
STORAGE_ORPHAN_SWEEP_ENABLED=true

# --- Account deletion and data export (client users) ---
# Default of the runtime setting account.deletionGraceDays (see above).
# Days a deleted account can still be restored; daily at 03:45 accounts past it are purged with all their
# data (knowledge bases, files, sessions, exports; audit rows keep the id but lose email and body). 0 = next run.
ACCOUNT_DELETION_GRACE_DAYS=15
# Hours a finished personal data export stays downloadable; expired exports are deleted daily at 03:15.
ACCOUNT_EXPORT_TTL_HOURS=72

# --- Seed (pnpm db:seed) ---
# First super admin of the admin console (admin_users; sign in at /api/v1/admin/auth/login). Client users register themselves.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NICKNAME=Administrator
# Default embedding model; editable later in the admin console (/api/v1/admin/ai/embedding-models).
# Ollama: docker compose --profile ai up -d && docker compose exec ollama ollama pull bge-m3
SEED_EMBEDDING_NAME=bge-m3
SEED_EMBEDDING_BASE_URL=http://localhost:11434/v1
SEED_EMBEDDING_MODEL=bge-m3
SEED_EMBEDDING_DIMENSIONS=1024
# SEED_EMBEDDING_API_KEY=
OLLAMA_PORT=11434

# --- Prometheus metrics (separate internal listener, never exposed through the gateway) ---
# Scrape http://<host>:9464/metrics: HTTP latency per route, BullMQ queue depth and job outcomes, pg pool, Node runtime.
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9464

# --- Local monitoring (docker-compose.yml profile `observability`; README "本地监控") ---
# Prometheus (scrapes host port 9464), Alertmanager (mail to Mailpit), Tempo (OTLP on 4318) and Grafana
# (http://localhost:3300). pnpm dev / infra:up / infra:down include the profiles listed here (comma-separated,
# e.g. observability,ai); remove the line to run only postgres/redis/rustfs/mailpit.
COMPOSE_PROFILES=observability
# GRAFANA_PORT=3300

# --- OpenTelemetry tracing (needs the preload, which pnpm dev, pnpm start:prod and the Docker image load) ---
# Enabled when an OTLP endpoint is set (http/protobuf, e.g. Tempo); leave it unset without Tempo. Other standard
# OTEL_* variables (OTEL_EXPORTER_OTLP_HEADERS, OTEL_EXPORTER_OTLP_PROTOCOL, OTEL_RESOURCE_ATTRIBUTES) are read by the SDK.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=agent-template-server
# Share of new traces kept (0-1); requests continuing an upstream trace follow its decision.
# OTEL_TRACES_SAMPLER_ARG=1
