{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "pnpm-workspace.yaml rejects versions younger than 24 h (minimumReleaseAge: 1440), so Renovate waits as long before proposing them; strict internal checks keep the PR closed until then."
  ],
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":separateMultipleMajorReleases"
  ],
  "timezone": "Asia/Shanghai",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "ignorePaths": [
    "**/node_modules/**",
    "apps/admin/.github/**"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "customManagers": [
    {
      "description": [
        "ARG PNPM_VERSION in the Dockerfiles must match the root packageManager."
      ],
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG PNPM_VERSION=(?<currentValue>\\S+)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": ["packageManager and the Dockerfile ARGs move together."],
      "matchDepNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "dev dependencies (non-major)"
    },
    {
      "matchPackageNames": ["@nestjs/**"],
      "groupName": "NestJS"
    },
    {
      "matchPackageNames": [
        "vue",
        "vue-router",
        "@vue/**",
        "vue-tsc",
        "vue-i18n",
        "pinia",
        "@vitejs/plugin-vue"
      ],
      "groupName": "Vue"
    },
    {
      "matchPackageNames": ["vite", "vitest", "@vitest/**"],
      "groupName": "Vite and Vitest"
    },
    {
      "matchPackageNames": ["drizzle-orm", "drizzle-kit"],
      "groupName": "Drizzle"
    },
    {
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"],
      "groupName": "Tailwind CSS"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": [
        "Major upgrades of PostgreSQL, Redis and RustFS change on-disk formats: upgrade them by hand with a backup."
      ],
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["pgvector/pgvector", "redis", "rustfs/rustfs"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
